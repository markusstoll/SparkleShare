<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Obsolete crypto APIs kept for binary-compatible hashes in Sparkles.Tests -->
    <NoWarn>$(NoWarn);SYSLIB0021;SYSLIB0022;SYSLIB0041</NoWarn>
  </PropertyGroup>
</Project>
