<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SparkleShare</RootNamespace>
    <AssemblyName>SparkleShare</AssemblyName>
    <ApplicationIcon>Images\sparkleshare-app.ico</ApplicationIcon>
    <ApplicationVersion>4.0.2</ApplicationVersion>
    <ApplicationDisplayVersion>4.0.2</ApplicationDisplayVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Self-contained publish for the WiX MSI (no separate .NET 10 runtime required). -->
  <PropertyGroup Condition="'$(BuildInstaller)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>$(MSBuildProjectDirectory)\bin\Release\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sparkles\Sparkles.csproj" />
    <ProjectReference Include="..\..\Sparkles\Git\Sparkles.Git.csproj" />
  </ItemGroup>

  <Import Project="..\Common\SparkleShare.projitems" Label="Shared" Condition="Exists('..\Common\SparkleShare.projitems')" />

  <ItemGroup>
    <Compile Update="UserInterface\Note.xaml.cs">
      <DependentUpon>Note.xaml</DependentUpon>
    </Compile>
    <Compile Remove="SparkleShareInviteOpener\**" />
    <EmbeddedResource Remove="SparkleShareInviteOpener\**" />
    <None Remove="SparkleShareInviteOpener\**" />
    <Page Remove="SparkleShareInviteOpener\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Common\Presets\bitbucket.png" Link="Presets\bitbucket.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Common\Presets\github.png" Link="Presets\github.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Common\Presets\own-server.png" Link="Presets\own-server.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Common\Presets\bitbucket.xml" Link="Presets\bitbucket.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Common\Presets\github.xml" Link="Presets\github.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Common\Presets\gitlab.xml" Link="Presets\gitlab.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Common\Presets\own-server.xml" Link="Presets\own-server.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Images\sparkleshare-folder.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\Images\about.png" Link="Images\about.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\Images\side-splash.png" Link="Images\side-splash.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\HTML\day-entry.html" Link="HTML\day-entry.html" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\HTML\event-entry.html" Link="HTML\event-entry.html" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\HTML\event-log.html" Link="HTML\event-log.html" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\HTML\jquery.js" Link="HTML\jquery.js" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\Images\user-icon-default.png" Link="Images\user-icon-default.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Linux\Images\icons\hicolor\12x12\status\document-added.png" Link="Images\document-added-12.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Linux\Images\icons\hicolor\12x12\status\document-deleted.png" Link="Images\document-deleted-12.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Linux\Images\icons\hicolor\12x12\status\document-edited.png" Link="Images\document-edited-12.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Linux\Images\icons\hicolor\12x12\status\document-moved.png" Link="Images\document-moved-12.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Linux\Images\icons\hicolor\22x22\status\process-working.png" Link="Images\process-working-22.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\folder.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\process-syncing-down.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\process-syncing-error.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\process-syncing-idle.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\process-syncing-up.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\process-syncing.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\sparkleshare-app.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\sparkleshare-folder.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\Images\tutorial-slide-1.png" Link="Images\tutorial-slide-1.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Common\Images\tutorial-slide-2.png" Link="Images\tutorial-slide-2.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Images\tutorial-slide-3.png" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\Common\Images\text-balloon.png" Link="Images\text-balloon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="SparkleShareWindowsPostBuild" AfterTargets="Build;Publish" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="&quot;$(ProjectDir)postBuild.cmd&quot; &quot;$(TargetDir)git_scm&quot;" />
  </Target>

</Project>
