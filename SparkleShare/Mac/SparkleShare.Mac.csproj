<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>SparkleShare</RootNamespace>
    <AssemblyName>SparkleShare</AssemblyName>
    <ApplicationId>org.sparkleshare.SparkleShare</ApplicationId>
    <ApplicationTitle>SparkleShare</ApplicationTitle>
    <ApplicationVersion>3.38.0</ApplicationVersion>
    <ApplicationDisplayVersion>3.38.0</ApplicationDisplayVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Required for .NET 10 macOS SDK when Xcode is not auto-detected -->
    <XcodeLocation Condition="'$(XcodeLocation)' == ''">/Applications/Xcode.app</XcodeLocation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sparkles\Sparkles.csproj" />
    <ProjectReference Include="..\..\Sparkles\Git\Sparkles.Git.csproj" />
  </ItemGroup>

  <!-- Shared SparkleShare/Common sources used by all platform heads -->
  <Import Project="..\Common\SparkleShare.projitems" Label="Shared" Condition="Exists('..\Common\SparkleShare.projitems')" />

  <!-- Interface Builder document -->
  <ItemGroup>
    <InterfaceDefinition Include="MainMenu.xib" />
  </ItemGroup>

  <!-- Mac-specific PNG icons in Resources/ are picked up by default by the macOS SDK -->

  <!-- Bundle resources shared with other platform projects -->
  <ItemGroup>
    <BundleResource Include="..\Common\Images\about.png" Link="Resources\about.png" />
    <BundleResource Include="..\Common\Images\about%402x.png" Link="Resources\about%402x.png" />
    <BundleResource Include="..\Common\Images\side-splash.png" Link="Resources\side-splash.png" />
    <BundleResource Include="..\Common\Images\side-splash%402x.png" Link="Resources\side-splash%402x.png" />
    <BundleResource Include="Resources\sparkleshare-app.icns" Link="Resources\sparkleshare-app.icns" />
    <BundleResource Include="Resources\sparkleshare-folder.icns" Link="Resources\sparkleshare-folder.icns" />
    <BundleResource Include="Resources\sparkleshare-folder-yosemite.icns" Link="Resources\sparkleshare-folder-yosemite.icns" />
    <BundleResource Include="..\Common\Images\text-balloon.png" Link="Resources\text-balloon.png" />
    <BundleResource Include="..\Common\Images\text-balloon%402x.png" Link="Resources\text-balloon%402x.png" />
    <BundleResource Include="..\Common\Images\tutorial-slide-1.png" Link="Resources\tutorial-slide-1.png" />
    <BundleResource Include="..\Common\Images\tutorial-slide-1%402x.png" Link="Resources\tutorial-slide-1%402x.png" />
    <BundleResource Include="..\Common\Images\tutorial-slide-2.png" Link="Resources\tutorial-slide-2.png" />
    <BundleResource Include="..\Common\Images\tutorial-slide-2%402x.png" Link="Resources\tutorial-slide-2%402x.png" />
    <BundleResource Include="Resources\tutorial-slide-3.png" Link="Resources\tutorial-slide-3.png" />
    <BundleResource Include="Resources\tutorial-slide-3%402x.png" Link="Resources\tutorial-slide-3%402x.png" />
    <BundleResource Include="..\Common\Images\user-icon-default.png" Link="Resources\user-icon-default.png" />

    <BundleResource Include="..\Common\Presets\bitbucket.png" Link="Presets\bitbucket.png" />
    <BundleResource Include="..\Common\Presets\bitbucket%402x.png" Link="Presets\bitbucket%402x.png" />
    <BundleResource Include="..\Common\Presets\github.png" Link="Presets\github.png" />
    <BundleResource Include="..\Common\Presets\github%402x.png" Link="Presets\github%402x.png" />
    <BundleResource Include="..\Common\Presets\gitlab.png" Link="Presets\gitlab.png" />
    <BundleResource Include="..\Common\Presets\gitlab%402x.png" Link="Presets\gitlab%402x.png" />
    <BundleResource Include="..\Common\Presets\own-server.png" Link="Presets\own-server.png" />
    <BundleResource Include="..\Common\Presets\own-server%402x.png" Link="Presets\own-server%402x.png" />
    <BundleResource Include="..\Common\Presets\bitbucket.xml" Link="Presets\bitbucket.xml" />
    <BundleResource Include="..\Common\Presets\github.xml" Link="Presets\github.xml" />
    <BundleResource Include="..\Common\Presets\gitlab.xml" Link="Presets\gitlab.xml" />
    <BundleResource Include="..\Common\Presets\own-server.xml" Link="Presets\own-server.xml" />

    <BundleResource Include="..\Common\HTML\day-entry.html" Link="HTML\day-entry.html" />
    <BundleResource Include="..\Common\HTML\event-entry.html" Link="HTML\event-entry.html" />
    <BundleResource Include="..\Common\HTML\event-log.html" Link="HTML\event-log.html" />
    <BundleResource Include="..\Common\HTML\jquery.js" Link="HTML\jquery.js" />

    <BundleResource Include="..\Linux\Images\icons\hicolor\12x12\status\document-added.png" Link="Resources\document-added.png" />
    <BundleResource Include="..\Linux\Images\icons\hicolor\12x12\status\document-deleted.png" Link="Resources\document-deleted.png" />
    <BundleResource Include="..\Linux\Images\icons\hicolor\12x12\status\document-edited.png" Link="Resources\document-edited.png" />
    <BundleResource Include="..\Linux\Images\icons\hicolor\12x12\status\document-moved.png" Link="Resources\document-moved.png" />
  </ItemGroup>

  <!-- AppDelegate.cs depends on the xib-generated partial class -->
  <ItemGroup>
    <Compile Update="AppDelegate.cs">
      <DependentUpon>MainMenu.xib</DependentUpon>
    </Compile>
    <Compile Update="MainMenu.xib.designer.cs">
      <DependentUpon>MainMenu.xib</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- The legacy SparkleShareInviteOpener prebuilt bundle is not part of the new build -->
  <ItemGroup>
    <Compile Remove="SparkleShareInviteOpener.app\**" />
    <None Remove="SparkleShareInviteOpener.app\**" />
  </ItemGroup>

  <!-- After the macOS workload finishes the .app bundle, unpack bundled git (see postBuild.sh + checkGit.sh). -->
  <Target Name="SparkleSharePostBuildBundle"
          AfterTargets="_PostProcessAppBundle"
          Condition="'$(_CanOutputAppBundle)' == 'true' And '$(DesignTimeBuild)' != 'true' And Exists('$(MSBuildProjectDirectory)/postBuild.sh')">
    <PropertyGroup>
      <_SparkleShareAppBundlePath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(_AppBundlePath)'))))</_SparkleShareAppBundlePath>
    </PropertyGroup>
    <Message Importance="High" Text="SparkleSharePostBuildBundle: $(_SparkleShareAppBundlePath)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="sh &quot;$(MSBuildProjectDirectory)/postBuild.sh&quot; &quot;$(_SparkleShareAppBundlePath)&quot;" />
  </Target>

</Project>
